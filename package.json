{
  "name": "frontend-system-design",
  "version": "1.1.0",
  "description": "Staff-level frontend architect, product copywriter and git workflow skills for AI coding tools (Claude Code, Cursor, GitHub Copilot, Windsurf, Gemini CLI, Codex). Designs the best UI and system for web, mobile and desktop on any stack, grounded in a 120-topic learning roadmap, and keeps commits, PRs and releases clean. One npx command also installs UI UX Pro Max, Impeccable, Vercel agent-skills, Anthropic frontend-design and Cloudflare security-audit.",
  "keywords": [
    "frontend",
    "system-design",
    "ui",

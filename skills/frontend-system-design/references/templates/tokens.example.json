{
  "$description": "Example design tokens in the W3C Design Tokens (DTCG) format. Raw values live in `palette`, components use the role tokens in `color.light` / `color.dark`. Check with: python3 scripts/tokens_check.py tokens.json",
  "color": {
    "$type": "color",
    "palette": {
      "gray-0": { "$value": "#ffffff" },
      "gray-50": { "$value": "#f6f7f9" },
      "gray-500": { "$value": "#5c606b" },
      "gray-450": { "$value": "#8a8f9a" },
      "gray-900": { "$value": "#1a1b20" },
      "gray-950": { "$value": "#121317" },
      "blue-600": { "$value": "#2a4fc9" },
      "blue-300": { "$value": "#93abff" },
      "blue-950": { "$value": "#0b1640" },
      "red-600": { "$value": "#c22a1c" },
      "red-300": { "$value": "#ff8c82" },
      "green-700": { "$value": "#1d7a3b" },
      "green-300": { "$value": "#70d08d" },
      "amber-400": { "$value": "#f2b200" }
    },
    "light": {
      "bg": { "$value": "{color.palette.gray-0}" },
      "surface": { "$value": "{color.palette.gray-50}" },
      "surface-raised": { "$value": "{color.palette.gray-0}" },
      "text": { "$value": "{color.palette.gray-900}" },
      "text-muted": { "$value": "{color.palette.gray-500}" },
      "border": { "$value": "{color.palette.gray-450}" },
      "primary": { "$value": "{color.palette.blue-600}" },
      "on-primary": { "$value": "{color.palette.gray-0}" },
      "danger": { "$value": "{color.palette.red-600}" },
      "on-danger": { "$value": "{color.palette.gray-0}" },
      "success": { "$value": "{color.palette.green-700}" },
      "on-success": { "$value": "{color.palette.gray-0}" },
      "warning": { "$value": "{color.palette.amber-400}" },
      "on-warning": { "$value": "{color.palette.gray-900}" },
      "focus-ring": { "$value": "{color.palette.blue-600}" }
    },
    "dark": {
      "bg": { "$value": "{color.palette.gray-950}" },
      "surface": { "$value": "#1b1d23" },
      "surface-raised": { "$value": "#24262e" },
      "text": { "$value": "#ececf1" },
      "text-muted": { "$value": "#a4a8b4" },
      "border": { "$value": "#6c717d" },
      "primary": { "$value": "{color.palette.blue-300}" },
      "on-primary": { "$value": "{color.palette.blue-950}" },
      "danger": { "$value": "{color.palette.red-300}" },
      "on-danger": { "$value": "#3b0905" },
      "success": { "$value": "{color.palette.green-300}" },
      "on-success": { "$value": "#062611" },
      "warning": { "$value": "#ffd166" },
      "on-warning": { "$value": "#2b2000" },
      "focus-ring": { "$value": "{color.palette.blue-300}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Major-third scale (×1.25) from a 16px base.",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "3.052rem", "fontWeight": "{font.weight.bold}", "lineHeight": 1.1, "letterSpacing": "-1px" } },
    "h1": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "2.441rem", "fontWeight": "{font.weight.bold}", "lineHeight": 1.15, "letterSpacing": "-0.5px" } },
    "h2": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "1.953rem", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.2, "letterSpacing": "-0.25px" } },
    "h3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "1.563rem", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.25, "letterSpacing": "0px" } },
    "h4": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "1.25rem", "fontWeight": "{font.weight.semibold}", "lineHeight": 1.3, "letterSpacing": "0px" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "1rem", "fontWeight": "{font.weight.regular}", "lineHeight": 1.5, "letterSpacing": "0px" } },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "0.8rem", "fontWeight": "{font.weight.medium}", "lineHeight": 1.4, "letterSpacing": "0.2px" } },
    "code": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "0.875rem", "fontWeight": "{font.weight.regular}", "lineHeight": 1.5, "letterSpacing": "0px" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "16px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "1": { "$value": { "color": "#1a1b2014", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
    "2": { "$value": { "color": "#1a1b201f", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } },
    "3": { "$value": { "color": "#1a1b2029", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "out": { "$value": [0.2, 0, 0, 1] },
    "in": { "$value": [0.4, 0, 1, 1] }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  },
  "z": {
    "$type": "number",
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "overlay": { "$value": 1300 },
    "modal": { "$value": 1400 },
    "toast": { "$value": 1500 }
  }
}
